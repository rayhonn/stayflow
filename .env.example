# StayFlow local development only. Never commit real secrets.
STAYFLOW_ENV=local
NODE_ENV=development

# API
API_PORT=3001
HOTEL_WEB_URL=http://localhost:3000
GUEST_WEB_URL=http://localhost:3002

# PostgreSQL
POSTGRES_DB=stayflow
POSTGRES_USER=stayflow
POSTGRES_PASSWORD=stayflow_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://stayflow:stayflow_local_only@localhost:5432/stayflow

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication
# DEVELOPMENT ONLY. Production must use the approved OIDC provider.
AUTH_MODE=development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=

# Observability
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
